# Copy these values into your shell or a local .env file. Never commit real keys.
OPENAI_API_KEY=

# Opik Cloud example. For a self-hosted instance, replace the endpoint with its
# OTLP endpoint and retain the projectName header.
OTEL_EXPORTER_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=<opik-api-key>,Comet-Workspace=default,projectName=smolagents-observability-demo
