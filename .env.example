# Merge into an existing .env without overwriting credentials.
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:55432/agent_runtime
TEST_DATABASE_URL=postgresql+psycopg://agent:agent@localhost:55432/agent_runtime_test
# Set a model supported by your endpoint. If omitted, legacy ANTHROPIC_MODEL is used.
MODEL=deepseek-chat
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
WORKER_CONCURRENCY=2
# Empty disables auth; set it to require Authorization: Bearer <token> on every endpoint.
API_TOKEN=
ARTIFACTS_DIR=artifacts
SKILLS_DIR=skills
SANDBOX_IMAGE=agent-runtime-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
TASK_TIMEOUT_SECONDS=600
RECURSION_LIMIT=40
MAX_EXPORT_ROWS=5000
# Empty command starts bundled mock with the current Python.
# Real Opik: MCP_STDIO_CMD=.venv-runtime/bin/python -m opik_adapter.server
MCP_TRANSPORT=stdio
MCP_STDIO_CMD=
MCP_HTTP_URL=
MCP_HTTP_TOKEN=
# Read by opik_adapter/ (passed to the MCP subprocess with .env as base).
OPIK_API_BASE=http://localhost:5173/api
OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=default
# Primary score metric; set it explicitly (e.g. safety for minor-safety-qlora).
# Empty falls back to the most frequent metric of the experiment.
OPIK_SCORE_NAME=
OPIK_TIMEOUT_SECONDS=30
OPIK_MAX_ITEMS=10000
OPIK_MAX_EXPERIMENTS=200
