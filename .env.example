# DeepSeek —— 通过 Anthropic 兼容端点接入 Claude Agent SDK
# 官方文档: https://api-docs.deepseek.com/zh-cn/quick_start/agent_integrations/claude_code
# 复制本文件为 .env 并填入 key:  cp .env.example .env
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
# 模型名后的 [1m] 表示 1M 上下文版本，按官方示例填写
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432

# Opik 数据源（本地自托管实例）
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=minor-safety-qlora
